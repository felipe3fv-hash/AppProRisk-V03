# Copie para .streamlit/secrets.toml (local) ou cole no painel do Streamlit
# em ⋮ → Settings → Secrets. NUNCA versione o arquivo real.

# ---------------------------------------------------------------------------
# Quem pode entrar no app.
# Uma linha por pessoa. O valor é gerado pela aba "Solicitar acesso" da própria
# tela de entrada (ou por `python criar_usuario.py <usuario>`).
# ---------------------------------------------------------------------------
[usuarios]
# mariz = "pbkdf2_sha256$260000$<salt>$<hash>"

# ---------------------------------------------------------------------------
# Envio automático das solicitações de acesso. OPCIONAL.
# Sem este bloco o app continua funcionando: a solicitação é mostrada na tela
# para o solicitante encaminhar, e fica registrada nos logs (Manage app).
#
# Com Gmail, `senha_app` NÃO é a senha da conta: é uma "senha de app" de 16
# caracteres, gerada em myaccount.google.com/apppasswords. Ela só existe se a
# verificação em duas etapas estiver ativa na conta.
# ---------------------------------------------------------------------------
# [email]
# remetente    = "proriskapp@gmail.com"
# senha_app    = "abcd efgh ijkl mnop"
# destinatario = "proriskapp@gmail.com"
# servidor     = "smtp.gmail.com"
# porta        = 465
